# ==============================================================================
# Been-There Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Direct database connection URL (used for migrations and Drizzle Kit)
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Connection pooler URL (optional / recommended for serverless runtimes)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true
DATABASE_POOLER_URL=""

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & Client Configuration
# ------------------------------------------------------------------------------
# Public Supabase project URL (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public anonymous key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Service role key (SERVER ONLY - never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------------------------
# 3. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
